# ==============================================================================
# Comprehensive .gitignore for Sovereign On-Premise Agentic AI Workbench
# Prevents accidental commits of secrets, runtime vaults, local models & caches
# ==============================================================================

# --- Secrets, Credentials & Environment Configurations ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Sovereign Runtime Vaults & Local Data ---
# Vault files containing encrypted sessions, physical recovery tokens & audit trails
session_vault/*.json
!session_vault/portal_sessions.example.json
!session_vault/.gitkeep

output/.vault/*
!output/.vault/profile.example.json
!output/.vault/.gitkeep

# Ingested user documents, private PDFs/DOCX and audio dictation buffers
output/uploads/*
!output/uploads/.gitkeep

output/temp_audio/*
!output/temp_audio/.gitkeep

# Generated binaries, packages, presentations & databases
output/*.zip
output/*.pdf
presentation/export/*.pdf
presentation/export/*.png
*.sqlite3
*.db

# --- Python Environment & Caches ---
__pycache__/
*.py[cod]
*.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Node.js & Web Build Caches ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Local AI Models & Daemons ---
# Downloaded Ollama weights and checkpoints
models/
*.bin
*.gguf
*.safetensors
*.onnx

# --- IDE, Editor & OS Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
.antigravity-ide/
.gemini/

# Graft local graph cache
/graft/
.graft/
