# ==============================================================================
# Sovereign On-Premise Agentic AI Workbench - Environment Configuration Template
# Copy this file to .env and adjust the values for your local deployment.
# ==============================================================================

# --- Server & Networking Configuration ---
HOST=127.0.0.1
PORT=8001
WORKBENCH_ENV=production
SOVEREIGN_SESSION_SECRET=replace_with_a_secure_random_hex_string_32_bytes

# --- Dual-Engine LLM Router Configuration ---
# Options: 'local' (Strict Air-Gap Sovereign Execution), 'auto' (Adaptive Cloud Burst), 'groq', 'gemini'
PREFERRED_ENGINE=local
LOCAL_MODEL=llama3.2:1b
OLLAMA_URL=http://127.0.0.1:11434

# --- Optional Cloud Burst Free Tier Credentials (Hackathon / Evaluation Only) ---
# When AIR_GAP_KILL_SWITCH is true, these keys are strictly ignored and zero traffic leaves localhost.
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# --- Air-Gap & Security Guardrails ---
AIR_GAP_KILL_SWITCH=false
MAX_UPLOAD_BYTES=52428800

# --- LAN & Local Connectivity Layer ---
NETWORK_MODE=LOCAL_ONLY
MDNS_ENABLED=true
BIND_HOST=0.0.0.0
TRUSTED_PROXIES=
DEV_TOKEN_AUTH=false
AUTH_REQUIRED_FOR_LAN=true
